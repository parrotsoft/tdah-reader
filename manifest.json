{
  "manifest_version": 3,
  "name": "Lector TDAH",
  "version": "1.0.0",
  "description": "Modo lector con pistas visuales al inicio de cada palabra.",
  "permissions": ["storage", "activeTab"],
  "action": {
    "default_title": "Abrir Lector TDAH",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
